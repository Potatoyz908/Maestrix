#!/usr/bin/env bash
# Open Maestri GTK 4 Native Linux Launcher
set -e

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_DIR="$(cd "$DIR/.." && pwd)"

# Set up local GObject introspection typelibs and Python extensions
export GI_TYPELIB_PATH="$HOME/.local/lib/girepository-1.0:${GI_TYPELIB_PATH:-}"
export PYTHONPATH="$HOME/.local/lib/python3.14/site-packages:$REPO_DIR/canvas-cairo:$REPO_DIR/canvas-cairo/src:$REPO_DIR:$PYTHONPATH"

# Ensure backend server binary exists. Pick the NEWEST build: a stale release binary next to a fresh
# debug build (or vice versa) would otherwise run an old server under a new UI.
SERVER_BIN=""
for candidate in \
    "$REPO_DIR/.build/release/open-maestri-server" \
    "$REPO_DIR/.build/debug/open-maestri-server" \
    "$HOME/.local/bin/open-maestri-server"; do
    if [ -f "$candidate" ]; then
        if [ -z "$SERVER_BIN" ] || [ "$candidate" -nt "$SERVER_BIN" ]; then
            SERVER_BIN="$candidate"
        fi
    fi
done

DATA_DIR="${OPEN_MAESTRI_DATA_DIR:-$HOME/.open-maestri}"
RUN_DIR="$DATA_DIR/run"
mkdir -p "$RUN_DIR"
SOCK_PATH="$RUN_DIR/agent.sock"

# True only when a server is actually LISTENING on the socket. The file alone proves nothing: a server that
# died (crash, reboot, kill) leaves agent.sock behind, and trusting it opens the app with no backend, so
# workspaces cannot switch and the Floors button stays disabled.
server_alive() {
    [ -S "$SOCK_PATH" ] || return 1
    python3 - "$SOCK_PATH" <<'PY' 2>/dev/null
import socket, sys
s = socket.socket(socket.AF_UNIX)
s.settimeout(1.0)
try:
    s.connect(sys.argv[1])
except OSError:
    sys.exit(1)
finally:
    s.close()
PY
}

# A server from before the run/server.port file existed cannot be found by the app: it would open OFFLINE (local shells with
# no MAESTRI_SOCKET, so `omaestri ask`/recruit fail inside agents). Replace THAT server (the one that owns this data dir's
# socket) with the current build.
if server_alive && [ ! -s "$RUN_DIR/server.port" ]; then
    OLD_PID="$(ss -xlpn 2>/dev/null | grep -F "$SOCK_PATH" | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2)"
    if [ -n "$OLD_PID" ] && [ "$(cat /proc/$OLD_PID/comm 2>/dev/null)" = "open-maestri-se" ]; then
        echo "♻️  Restarting the outdated Open Maestri server (pid $OLD_PID)..."
        kill "$OLD_PID" 2>/dev/null
        for i in $(seq 1 30); do kill -0 "$OLD_PID" 2>/dev/null || break; sleep 0.1; done
        rm -f "$SOCK_PATH"
    fi
fi

# Start background server if not currently running
if [ -n "$SERVER_BIN" ] && ! server_alive; then
    rm -f "$SOCK_PATH"   # stale socket from a dead server
    echo "🚀 Starting Open Maestri background server ($SERVER_BIN)..."
    nohup "$SERVER_BIN" > "$RUN_DIR/server.log" 2>&1 &
    # Wait until the server really accepts connections (not just until the file exists)
    for i in $(seq 1 50); do
        if server_alive; then
            break
        fi
        sleep 0.1
    done
    if ! server_alive; then
        echo "⚠️  The Open Maestri server did not start; the app will run OFFLINE (Floors and live sync disabled)." >&2
        echo "    See $RUN_DIR/server.log" >&2
    fi
elif [ -z "$SERVER_BIN" ]; then
    echo "⚠️  open-maestri-server not found (run 'swift build'); the app will run OFFLINE." >&2
fi

# Launch Native GTK 4 Desktop Application
exec python3 "$REPO_DIR/gtk4-ui/src/app.py" "$@"
